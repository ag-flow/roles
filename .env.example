# === Image registry (GitHub Container Registry) ===
# Owner du repo GitHub (lowercase). Utilisé pour pull les images depuis GHCR.
GHCR_OWNER=
# Tag d'image commun à toutes les images Role Builder (backend, frontend, scrapers, workers)
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=rb
POSTGRES_PASSWORD=changeme_in_real_env
POSTGRES_DB=role_builder
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_in_real_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenBao (mode dev pour bootstrap, à remplacer en prod)
OPENBAO_DEV_TOKEN=dev-only-token-change-me
OPENBAO_PORT=8200

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql://rb:changeme_in_real_env@localhost:5432/role_builder
MINIO_ENDPOINT=http://localhost:9000
OPENBAO_URL=http://localhost:8200

# ag.flow (utilisé Sprint 4+)
AGFLOW_BASE_URL=https://docker-agflow.yoops.org

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookies de scraping (base64 du fichier cookies.txt). Vides = contenus publics seulement.
YOUTUBE_COOKIES_B64=
INSTAGRAM_COOKIES_B64=
TIKTOK_COOKIES_B64=

# Cap simultané de scrapers Docker (sémaphore asyncio)
MAX_CONCURRENT_SCRAPERS=5

# Sprint 3 — Transcription
# Clés API SaaS (vides = pas de provisioning auto, fallback sur shared_default)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=

# Auto-stop des workers user idle (seuil + période de check de la boucle)
WORKER_AUTO_STOP_THRESHOLD_S=300
WORKER_AUTO_STOP_PERIOD_S=60

# === Auth Keycloak (Phase 2) ===
# OIDC issuer (URL réalm Keycloak). Ex: https://security.yoops.org/realms/yoops
KEYCLOAK_ISSUER_URL=
# Client ID OIDC créé dans Keycloak (Authorization Code + PKCE)
KEYCLOAK_CLIENT_ID=
# Client secret OIDC (NE JAMAIS COMMIT — copier dans le .env du LXC seulement)
KEYCLOAK_CLIENT_SECRET=
# Audience attendue dans le JWT (par défaut = client_id)
KEYCLOAK_AUDIENCE=

# Auth.js (Next.js) — NEXTAUTH_SECRET à générer via : openssl rand -hex 32
NEXTAUTH_SECRET=
# URL publique du site (utilisée par Auth.js pour les callbacks). Ex: https://role-agflow.yoops.org
NEXTAUTH_URL=

# Bypass total de l'auth (TESTS / DEV uniquement — DOIT être false en prod)
DISABLE_AUTH=false

# === Login local (dev / test) ===
# Permet de bypass Keycloak avec un user/password fixe pour tester sans SSO.
# DEV_LOGIN_ENABLED=true active le provider Credentials côté frontend.
# DEV_LOGIN_PASSWORD non-vide est requis (sinon le provider reste désactivé).
# À combiner avec DISABLE_AUTH=true côté backend pour que les API soient
# accessibles sans validation JWT Keycloak.
# DOIT être désactivé en prod.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_USER=admin
DEV_LOGIN_PASSWORD=

# === Sprint 4 — Mistral (LLM + embeddings) ===
# MVP : appel direct api.mistral.ai. À swap vers ag.flow quand l'OpenAPI sera figé.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-large-latest

# Worker chunking (asyncio task interne au backend)
DISABLE_CHUNKING_WORKER=false
