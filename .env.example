# === Image registry (GitHub Container Registry) ===
# Owner du repo GitHub (lowercase). Utilisé pour pull les images depuis GHCR.
GHCR_OWNER=
# Tag d'image commun à toutes les images Role Builder (backend, frontend, scrapers, workers)
IMAGE_TAG=latest
# Tags spécifiques scrapers/workers (par défaut = IMAGE_TAG, cf. docker-compose-dev.yml)
SCRAPER_IMAGE_TAG=latest
WORKER_IMAGE_TAG=latest

# === Secrets utilisateur (wallets Harpocrate self-service) ===
# Plus de token Harpocrate d'instance : les utilisateurs enregistrent leurs
# propres wallets via /api/wallets. Cette clé Fernet (32 octets base64
# url-safe, générée par dev-deploy.sh) chiffre en base les tokens de wallets
# et les secrets stockés en "local". À générer via :
#   openssl rand -base64 32 | tr '+/' '-_'
SECRET_ENCRYPTION_KEY=
# Autorise http:// pour les URLs de wallets Harpocrate (dev local uniquement).
# Lu directement via os.environ (secrets/harpocrate/http.py).
HARPOCRATE_ALLOW_INSECURE=0

# PostgreSQL
POSTGRES_USER=rb
POSTGRES_PASSWORD=changeme_in_real_env
POSTGRES_DB=role_builder
# --- Ports publiés ---
# Ces valeurs sont des DÉFAUTS, résolus automatiquement par dev-deploy.sh après
# l'arrêt de la stack : si le défaut est occupé sur la machine cible, le script
# bascule sur le premier port libre à partir de défaut+10000 et PERSISTE le choix
# ici. Les machines de test sont partagées — 8000, 5432 et 3000 y sont souvent
# déjà pris par d'autres stacks.
# La résolution a lieu à CHAQUE déploiement, et le script distingue ses propres
# replis d'un port choisi par un humain (il mémorise les valeurs qu'il a
# attribuées dans /var/lib/roles-dev-deploy/auto-ports) :
#  - son repli précédent est conservé tant qu'il est libre — le ramener au défaut
#    dès qu'il se libère déplacerait l'URL publiée sous les pieds de ce qui
#    l'utilise ;
#  - si ce repli a été pris entre-temps, il en résout un nouveau.
# Pour IMPOSER un port, écris-le ici : une valeur non-défaut est respectée, et le
# déploiement échoue explicitement si ce port est occupé plutôt que de le déplacer
# en silence (ce qui casserait un reverse-proxy ou une exposition déclarée).
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_in_real_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql://rb:changeme_in_real_env@localhost:5432/role_builder
MINIO_ENDPOINT=http://localhost:9000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookies scraping (base64 d'un cookies.txt Netscape) — vides = contenus publics seulement
YOUTUBE_COOKIES_B64=
INSTAGRAM_COOKIES_B64=
TIKTOK_COOKIES_B64=

# Cap simultané de scrapers Docker (sémaphore asyncio)
MAX_CONCURRENT_SCRAPERS=5

# === Relais audio par volume local (remplace l'upload MinIO du scraper) ===
# L'audio ne passe plus par MinIO : le scraper l'écrit dans un répertoire
# monté sur le host, le worker de transcription le lit là et le supprime
# après un succès (le garde en cas d'échec, pour qu'un retry le retrouve).
# Chemin DANS les conteneurs scraper/worker (monté depuis AUDIO_VOLUME_HOST_DIR).
AUDIO_VOLUME_DIR=/mnt/corpus-audio
# OBLIGATOIRE en déploiement réel : chemin côté HOST du même volume (l'autre
# face du bind mount `-v host:conteneur`). Vide par défaut = l'orchestrateur
# et worker_manager refusent tout job/worker plutôt que d'écrire l'audio
# dans le système de fichiers éphémère d'un conteneur qui disparaît avec lui.
AUDIO_VOLUME_HOST_DIR=
# Rétention (heures) avant suppression d'un fichier orphelin par le balayeur
# périodique — seulement s'il n'est référencé par AUCUN transcription_job
# encore pending/claimed/processing (un retry doit retrouver son audio).
AUDIO_ORPHAN_RETENTION_H=48
# Garde disque : en dessous de ce seuil de Go libres sur AUDIO_VOLUME_DIR,
# l'orchestrateur refuse tout nouveau job plutôt que de remplir le disque
# en silence.
AUDIO_MIN_FREE_GB=5
# Période (minutes) du job périodique de balayage des orphelins.
AUDIO_SWEEP_INTERVAL_MIN=60

# Auto-stop des workers user idle (seuil + période de check de la boucle)
WORKER_AUTO_STOP_THRESHOLD_S=300
WORKER_AUTO_STOP_PERIOD_S=60

# === Transcription SaaS — clés partagées/fallback (Sprint 3) ===
# Clés de secours utilisées quand un user n'a pas sa propre clé provider.
# Vides = pas de fallback global (chaque user doit avoir sa propre clé).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=

# === Auth Keycloak (Phase 2) ===
# OIDC issuer (URL réalm Keycloak). Ex: https://security.yoops.org/realms/yoops
KEYCLOAK_ISSUER_URL=
# Client ID OIDC créé dans Keycloak (Authorization Code + PKCE)
KEYCLOAK_CLIENT_ID=
# Client secret OIDC (NE JAMAIS COMMIT — copier dans le .env du LXC seulement)
KEYCLOAK_CLIENT_SECRET=
# Audience attendue dans le JWT (par défaut = client_id)
KEYCLOAK_AUDIENCE=

# Auth.js (Next.js) — généré par dev-deploy.sh (openssl rand -hex 32)
NEXTAUTH_SECRET=
# URL publique du site (utilisée par Auth.js pour les callbacks). Ex: https://role-agflow.yoops.org
NEXTAUTH_URL=


# Bypass total de l'auth (TESTS / DEV uniquement — DOIT être false en prod)
DISABLE_AUTH=false

# === Auth admin local (sans OIDC) ===
# Permet à un admin de se connecter avec un user/password lu depuis ce .env,
# sans dépendre de Keycloak. Le frontend POST /api/auth/local-login → le
# backend valide contre LOCAL_ADMIN_USER/PASSWORD et retourne un JWT HS256.
# Le JWT est ensuite envoyé en Bearer comme un token Keycloak ; le backend
# accepte les deux (dispatcher dans auth.dependencies).
#
# Activation : mettre LOCAL_ADMIN_ENABLED=true ET un PASSWORD non vide
# ET un SECRET d'au moins 32 caractères (utiliser openssl rand -hex 32).
# DOIT être désactivé en prod (à moins d'un usage break-glass contrôlé).
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USER=admin
# Générés par dev-deploy.sh si vides
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_SECRET=
# Durée de vie du JWT local en secondes (défaut 12h)
LOCAL_ADMIN_TOKEN_TTL_S=43200
# Email affiché pour l'admin local (optionnel)
LOCAL_ADMIN_EMAIL=

# === Flags avancés (tests / dev local) ===
# Non transmis au conteneur backend par docker-compose-dev.yml sauf
# mention contraire ci-dessous — utiles surtout en dev local hors docker
# (ex. uv run uvicorn). DOIVENT être false en usage normal.
DISABLE_SCHEDULER=false
DISABLE_MIGRATIONS=false
DISABLE_ORCHESTRATOR=false
DISABLE_WS_RELAY=false
DISABLE_WORKER_MANAGER=false
DISABLE_MCP_SERVER=false
DISABLE_DEPOSIT_WORKER=false

# === V2 lot 4 — Dépôt docflow ===
# Backend de dépôt des transcripts : stub (défaut : fichiers JSON locaux +
# refs factices, permet de tester tout le cycle sans docflow) ou gateway
# (passerelle MCP — pas encore implémenté, cf. services/deposit/gateway.py).
DEPOSIT_BACKEND=stub
STUB_DEPOSIT_DIR=./stub-deposits
DEPOSIT_MAX_ATTEMPTS=3
DEPOSIT_BACKOFF_BASE_S=1.0
DEPOSIT_POLL_INTERVAL_S=2.0
