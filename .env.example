# === Image registry (GitHub Container Registry) ===
# Owner du repo GitHub (lowercase). Utilisé pour pull les images depuis GHCR.
GHCR_OWNER=
# Tag d'image commun à toutes les images Role Builder (backend, frontend, scrapers, workers)
IMAGE_TAG=latest
# Tags spécifiques scrapers/workers (par défaut = IMAGE_TAG, cf. docker-compose-dev.yml)
SCRAPER_IMAGE_TAG=latest
WORKER_IMAGE_TAG=latest

# === Harpocrate — coffre de secrets applicatifs ===
# Token API complet (format hrpv_*). Le SDK sépare auth_secret + decryption_key.
# Identifier logique = "api1" → ${vault://api1:<nom_du_secret>}
HARPOCRATE_API_TOKEN=
HARPOCRATE_API_URL=https://vault.yoops.org
# Autorise http:// au lieu de https:// pour HARPOCRATE_API_URL (dev local
# uniquement). Lu directement via os.environ (secrets/harpocrate/http.py),
# pas via config.Settings.
HARPOCRATE_ALLOW_INSECURE=0

# PostgreSQL
POSTGRES_USER=rb
POSTGRES_PASSWORD=changeme_in_real_env
POSTGRES_DB=role_builder
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_in_real_env
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql://rb:changeme_in_real_env@localhost:5432/role_builder
MINIO_ENDPOINT=http://localhost:9000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookies scraping (base64 d'un cookies.txt Netscape) — vides = contenus publics seulement
YOUTUBE_COOKIES_B64=
INSTAGRAM_COOKIES_B64=
TIKTOK_COOKIES_B64=

# Cap simultané de scrapers Docker (sémaphore asyncio)
MAX_CONCURRENT_SCRAPERS=5

# Auto-stop des workers user idle (seuil + période de check de la boucle)
WORKER_AUTO_STOP_THRESHOLD_S=300
WORKER_AUTO_STOP_PERIOD_S=60

# === Transcription SaaS — clés partagées/fallback (Sprint 3) ===
# Clés de secours utilisées quand un user n'a pas sa propre clé provider.
# Vides = pas de fallback global (chaque user doit avoir sa propre clé).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=

# === Auth Keycloak (Phase 2) ===
# OIDC issuer (URL réalm Keycloak). Ex: https://security.yoops.org/realms/yoops
KEYCLOAK_ISSUER_URL=
# Client ID OIDC créé dans Keycloak (Authorization Code + PKCE)
KEYCLOAK_CLIENT_ID=
# Client secret OIDC (NE JAMAIS COMMIT — copier dans le .env du LXC seulement)
KEYCLOAK_CLIENT_SECRET='${vault://HARPOCRATE_API_TOKEN:keycloak_client_secret}'
# Audience attendue dans le JWT (par défaut = client_id)
KEYCLOAK_AUDIENCE=

# Auth.js (Next.js) — NEXTAUTH_SECRET à générer via : openssl rand -hex 32
NEXTAUTH_SECRET='${vault://HARPOCRATE_API_TOKEN:nextauth_secret}'
# URL publique du site (utilisée par Auth.js pour les callbacks). Ex: https://role-agflow.yoops.org
NEXTAUTH_URL=


# Bypass total de l'auth (TESTS / DEV uniquement — DOIT être false en prod)
DISABLE_AUTH=false

# === Auth admin local (sans OIDC) ===
# Permet à un admin de se connecter avec un user/password lu depuis ce .env,
# sans dépendre de Keycloak. Le frontend POST /api/auth/local-login → le
# backend valide contre LOCAL_ADMIN_USER/PASSWORD et retourne un JWT HS256.
# Le JWT est ensuite envoyé en Bearer comme un token Keycloak ; le backend
# accepte les deux (dispatcher dans auth.dependencies).
#
# Activation : mettre LOCAL_ADMIN_ENABLED=true ET un PASSWORD non vide
# ET un SECRET d'au moins 32 caractères (utiliser openssl rand -hex 32).
# DOIT être désactivé en prod (à moins d'un usage break-glass contrôlé).
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD='${vault://HARPOCRATE_API_TOKEN:local_admin_password}'
LOCAL_ADMIN_SECRET='${vault://HARPOCRATE_API_TOKEN:local_admin_secret}'
# Durée de vie du JWT local en secondes (défaut 12h)
LOCAL_ADMIN_TOKEN_TTL_S=43200
# Email affiché pour l'admin local (optionnel)
LOCAL_ADMIN_EMAIL=

# === Flags avancés (tests / dev local) ===
# Non transmis au conteneur backend par docker-compose-dev.yml sauf
# mention contraire ci-dessous — utiles surtout en dev local hors docker
# (ex. uv run uvicorn). DOIVENT être false en usage normal.
DISABLE_SCHEDULER=false
DISABLE_VAULT=false
DISABLE_MIGRATIONS=false
DISABLE_ORCHESTRATOR=false
DISABLE_WS_RELAY=false
DISABLE_WORKER_MANAGER=false
DISABLE_MCP_SERVER=false
DISABLE_DEPOSIT_WORKER=false

# === V2 lot 4 — Dépôt docflow ===
# Backend de dépôt des transcripts : stub (défaut : fichiers JSON locaux +
# refs factices, permet de tester tout le cycle sans docflow) ou gateway
# (passerelle MCP — pas encore implémenté, cf. services/deposit/gateway.py).
DEPOSIT_BACKEND=stub
STUB_DEPOSIT_DIR=./stub-deposits
DEPOSIT_MAX_ATTEMPTS=3
DEPOSIT_BACKOFF_BASE_S=1.0
DEPOSIT_POLL_INTERVAL_S=2.0
