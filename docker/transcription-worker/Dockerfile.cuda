# Variante CUDA pour le pool shared sur pve2 (RTX 4090).
# Tag confirmé via API Docker Hub JSON brut (pas un résumé LLM).
# 12.8.1-cudnn-runtime-ubuntu24.04 : version stable récente, RTX 4090 supportée
# (CUDA 12.x couvre Ada Lovelace SM 8.9), Ubuntu 24.04 a python3.12 natif.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip \
        ffmpeg ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python3 && \
    pip install --no-cache-dir --break-system-packages uv

WORKDIR /app

COPY pyproject.toml uv.lock /app/
# --break-system-packages : Ubuntu 24.04 marque le Python système comme
# "externally managed" (PEP 668). Le container est déjà un env isolé,
# donc on by-pass cette protection plutôt que créer un venv intermédiaire.
RUN uv pip install --system --break-system-packages --no-cache .

COPY worker/ /app/worker/

ENV PYTHONPATH=/app

CMD ["python", "-m", "worker.main"]
