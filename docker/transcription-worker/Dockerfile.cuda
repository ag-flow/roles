# Variante CUDA pour le pool shared sur pve2 (RTX 4090).
# Tag NVIDIA vérifié sur Docker Hub : 12.4.1-cudnn-runtime-ubuntu24.04 existe.
# Ubuntu 24.04 (noble) a python3.12 par défaut → pas besoin de PPA deadsnakes.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu24.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip \
        ffmpeg ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.12 /usr/local/bin/python3 && \
    pip install --no-cache-dir --break-system-packages uv

WORKDIR /app

COPY pyproject.toml uv.lock /app/
RUN uv pip install --system --python /usr/bin/python3.12 --no-cache .

COPY worker/ /app/worker/

ENV PYTHONPATH=/app

CMD ["python", "-m", "worker.main"]
